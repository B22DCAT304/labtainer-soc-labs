#!/bin/bash
set -euo pipefail

chain=LAB14_SSH
out=/var/log/lab14/policy-verify.txt
rm -f "$out"

iptables -C INPUT -p tcp --dport 2222 -j "$chain"

first=$(iptables -S "$chain" | sed -n '2p')
last=$(iptables -S "$chain" | tail -n 1)

echo "$first" |
    grep -Eq -- '^-A LAB14_SSH -s 172\.31\.64\.50(/32)? -j DROP$'

test "$last" = "-A LAB14_SSH -j DROP"

echo "LAB14_FIREWALL_STATE_PASS" > "$out"
echo "LAB14_FIREWALL_STATE_PASS"
