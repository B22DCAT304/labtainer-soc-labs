GLOBAL_SETTINGS
    REGISTRY trongbua
    LAB_MASTER_SEED lt-lab14-ssh-deception_student_master_seed

NETWORK LAB14_EXT_NET
    MASK 172.31.64.0/24
    GATEWAY 172.31.64.254

NETWORK LAB14_SOC_NET
    MASK 10.60.214.0/24
    GATEWAY 10.60.214.254

CONTAINER ext-client
    USER ubuntu
    X11 YES
    LAB14_EXT_NET 172.31.64.50

CONTAINER ssh-decoy
    USER ubuntu
    X11 YES
    LAB14_EXT_NET 172.31.64.40
    LAB14_SOC_NET 10.60.214.40

CONTAINER soc
    USER ubuntu
    X11 YES
    LAB14_SOC_NET 10.60.214.10
