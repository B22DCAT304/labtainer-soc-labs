_decoy = ssh-decoy:/var/log/lab14/decoy.jsonl : FILE_REGEX : (?=.*"eventid": "lab14\.session\.connect")(?=.*"src_ip": "172\.31\.64\.50")
_alert = soc:/var/log/lab14-soc/alerts.jsonl : FILE_REGEX : (?=.*"eventid": "lab14\.alert\.high")(?=.*"severity": "high")(?=.*"src_ip": "172\.31\.64\.50")
_integrity = soc:/var/log/lab14-soc/integrity-check.txt : FILE_REGEX : LAB14_EVIDENCE_INTEGRITY_PASS
_policy = ssh-decoy:/var/log/lab14/policy.log : FILE_REGEX : LAB14_POLICY default_deny=yes scope=ssh port=2222 least_privilege=yes
_firewall = ssh-decoy:/var/log/lab14/policy-verify.txt : FILE_REGEX : LAB14_FIREWALL_STATE_PASS
_postblock = ext-client:/var/log/lab14/post-block.out : FILE_REGEX : LAB14_POST_BLOCK_PASS: attacker connection dropped
_report = soc:/var/log/lab14-soc/report-check.txt : FILE_REGEX : LAB14_INCIDENT_REPORT_PASS
