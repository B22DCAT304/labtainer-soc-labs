honeypot_session_verified = boolean : (_decoy)
#DOC honeypot_session_verified : SSH-DECOY recorded an attacker session.
soc_high_alert = boolean : (_alert)
#DOC soc_high_alert : SOC detected suspicious SSH commands and raised a HIGH alert.
evidence_integrity_verified = boolean : (_integrity)
#DOC evidence_integrity_verified : Analyst verified session evidence and SHA-256.
default_deny_configured = boolean : (_policy)
#DOC default_deny_configured : SSH service policy includes scoped Default Deny and Least Privilege.
firewall_containment_verified = boolean : (_firewall)
#DOC firewall_containment_verified : Firewall state confirms the attacker block precedes other rules.
post_block_test_verified = boolean : (_postblock)
#DOC post_block_test_verified : Attacker confirmed new SSH connections are blocked.
incident_report_verified = boolean : (_report)
#DOC incident_report_verified : Analyst submitted a report matching actual session evidence.
